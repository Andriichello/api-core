{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "andriichello/api-core",
    "type": "library",
    "description": "The core code for Laravel APIs.",
    "keywords": ["laravel", "framework", "core"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "spatie/laravel-permission": "^7.4"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpmd/phpmd": "^3.0",
        "phpro/grumphp": "^2.25",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5.12",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "app/",
            "Core\\Database\\Factories\\": "database/factories/",
            "Core\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi && XDEBUG_MODE=off php artisan test --parallel --processes=6"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Core\\Providers\\CoreServiceProvider",
                "Core\\Providers\\AuthServiceProvider",
                "Core\\Providers\\MorphServiceProvider"
            ],
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpro/grumphp": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
